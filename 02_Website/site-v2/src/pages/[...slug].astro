---
import { getCollection, render } from 'astro:content';
import Inner from '../layouts/Inner.astro';
import BookForm from '../components/BookForm.astro';
import { fillDeep } from '../lib/phones.mjs';
import { SITE, waLink } from '../lib/site';
import { ICON_CALL, ICON_WA } from '../lib/icons.mjs';
import { parts } from '../lib/inner.mjs';
export async function getStaticPaths() {
  const pages = await getCollection('pages', (p) => !p.data.draft && p.id !== 'home');
  return pages.map((p) => ({ params: { slug: p.id }, props: { entry: p } }));
}
const { entry } = Astro.props;
const d = fillDeep(entry.data);
const path = `/${entry.id}/`;
const ids = entry.id.split('/');
const crumbs = [{ name: 'Home', href: '/' }];
if (ids[0] === 'location' && ids.length > 1) crumbs.push({ name: 'Location', href: '/location/' });
crumbs.push({ name: d.title.split('|')[0].trim(), href: path });
const T = d.pageType;
const eyebrow: Record<string, string> = { plots: 'Industrial plots', amenities: 'Inside the park', location: 'Location', landing: 'Location', brands: 'Around us', faq: 'Questions', contact: 'Visit', about: 'About', other: 'Isapur Industrial Park' };
const vis = T === 'location' || T === 'landing' ? 'where' : T === 'amenities' || T === 'brands' ? 'gate' : T === 'plots' || entry.id === 'approvals' ? 'papers' : 'truck';
const rows: string[][] = d.place ? JSON.parse(d.place) : [];
const faqs: { q: string; a: string }[] = d.faq ?? [];
const GROUPS = [['Plots', 4], ['Buying a plot', 4], ['Inside the park', 6], ['Location', 4], ['Your visit', 3]] as const;
const groups: { h: string; items: { q: string; a: string }[] }[] = [];
let at = 0;
for (const [h, n] of GROUPS) { if (at < faqs.length) groups.push({ h, items: faqs.slice(at, at + n) }); at += n; }
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const md = (t: string) => esc(t).replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>').replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
const secs = T === 'faq' ? [] : await parts(entry.body);
const table = rows.length ? `<table class="dist"><thead><tr><th>To</th><th>By road</th><th>Time</th></tr></thead><tbody>${rows.map((r) => `<tr><td>${r[0]}</td><td class="nw">${r[1]}</td><td class="nw">${r[2]}</td></tr>`).join('')}</tbody></table><p class="cap">By road, measured on Google Maps, 6 November 2026.</p>` : '';
const dir = 'https://www.google.com/maps/search/?api=1&query=Isapur+Industrial+Park+Hapur+Modinagar+Road';
const tel = SITE.phones[0];
---
<Inner title={d.title} description={d.description} path={path} pageType={T} crumbs={crumbs} faq={T === 'faq' ? faqs : undefined} place={d.schema.includes('Place')} eyebrow={eyebrow[T] ?? eyebrow.other} h1={d.h1} lead={d.lead} vis={vis}>
  {T === 'faq' ? groups.map((g, i) => (
    <section class="sec is faqg" id={`q${i + 1}`} aria-labelledby={`q${i + 1}-h`}>
      <div class="wrap isg">
        <div class="isg__h"><h2 id={`q${i + 1}-h`}>{g.h}</h2></div>
        <div class="isg__b"><div class="faq">{g.items.map((f) => <details><summary>{f.q}<span aria-hidden="true"></span></summary><p set:html={md(f.a)}></p></details>)}</div></div>
      </div>
    </section>
  )) : T === 'contact' ? (
    <>
      <section class="sec is" id="book" aria-labelledby="book-h">
        <div class="wrap ct">
          <div class="ct__i">
            <address>Hapur-Modinagar Road,<br>Yusufpur Isapur, Ghaziabad, UP 201022</address>
            <dl class="hours"><dt>Monday</dt><dd>8 am to 8 pm</dd><dt>Tuesday</dt><dd class="x">Closed</dd><dt>Wednesday to Sunday</dt><dd>8 am to 8 pm</dd></dl>
            <div class="btns">
              <a class="b b--g" href={`tel:${tel.tel}`} data-cta-id="contact-call" data-section="contact"><Fragment set:html={ICON_CALL} />{tel.display}</a>
              <a class="b b--o" href={waLink()} rel="noopener" data-cta-id="contact-wa" data-section="contact"><Fragment set:html={ICON_WA} />WhatsApp</a>
              <a class="b b--o" href={dir} rel="noopener" data-cta-id="contact-directions" data-section="contact">Get directions</a>
            </div>
          </div>
          <div class="ct__f panel"><h2 id="book-h">Book a site visit</h2><BookForm /></div>
        </div>
      </section>
      {secs.map((g, i) => (
        <section class="sec is" id={`s${i + 1}`} aria-labelledby={`s${i + 1}-h`}>
          <div class="wrap isg"><div class="isg__h"><h2 id={`s${i + 1}-h`}>{g.h}</h2></div><div class="isg__b prose" set:html={g.html}></div></div>
        </section>
      ))}
    </>
  ) : secs.map((g, i) => (
    <section class="sec is" id={`s${i + 1}`} aria-labelledby={`s${i + 1}-h`}>
      <div class="wrap isg"><div class="isg__h"><h2 id={`s${i + 1}-h`}>{g.h}</h2></div><div class="isg__b prose" set:html={(i === 0 ? table : '') + g.html}></div></div>
    </section>
  ))}
</Inner>
