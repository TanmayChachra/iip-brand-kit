---
import { getCollection } from 'astro:content';
import Inner from '../../layouts/Inner.astro';
const posts = (await getCollection('posts', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
---
<Inner title="Industrial plot guides | Isapur Industrial Park" description="Plain guides for factory owners: how to choose an industrial plot and what to check before you buy." path="/blog/" pageType="blog" crumbs={[{ name: 'Home', href: '/' }, { name: 'Guides', href: '/blog/' }]} eyebrow="Guides" h1="Guides for industrial plot buyers" lead="Two short guides for buyers of plots from 300 sq yards.">
  <section class="sec is" id="guides" aria-labelledby="guides-h">
    <div class="wrap isg">
      <div class="isg__h"><h2 id="guides-h">All plot guides</h2></div>
      <div class="isg__b"><div class="postlist">{posts.map((p) => <a href={`/blog/${p.id}/`}><h3>{p.data.h1}</h3><p>{p.data.description}</p><span class="more">Read the guide</span></a>)}</div></div>
    </div>
  </section>
</Inner>
