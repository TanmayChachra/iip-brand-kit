---
import { getCollection } from 'astro:content';
import Inner from '../../layouts/Inner.astro';
import { fillDeep } from '../../lib/phones.mjs';
import { parts } from '../../lib/inner.mjs';
export async function getStaticPaths() {
  const posts = await getCollection('posts', (p) => !p.data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { entry: p } }));
}
const { entry } = Astro.props;
const d = fillDeep(entry.data);
const secs = await parts(entry.body);
const path = `/blog/${entry.id}/`;
---
<Inner title={d.title} description={d.description} path={path} pageType="blog" article={{ date: d.date }} faq={d.faq} crumbs={[{ name: 'Home', href: '/' }, { name: 'Guides', href: '/blog/' }, { name: d.h1, href: path }]} eyebrow="Guide" h1={d.h1} lead={d.lead ?? d.description} vis="truck">
  {secs.map((g, i) => (
    <section class="sec is" id={`s${i + 1}`} aria-labelledby={`s${i + 1}-h`}>
      <div class="wrap isg"><div class="isg__h"><h2 id={`s${i + 1}-h`}>{g.h}</h2></div><div class="isg__b prose" set:html={g.html}></div></div>
    </section>
  ))}
</Inner>
