---
// Home v3 round 2: "The Groundwork for Growth". A shed builds itself on the plot as you scroll. Facts: 00_ISAPUR_KNOWLEDGE.md, 06_Content/approvals-facts.md.
// Assets: scripts/build_home_assets.py. Anything marked DRAFT is a guess to confirm with the owner (also listed in 02_Website/V3-HOME.md).
import Home from '../layouts/Home.astro';
import Shed from '../components/Shed.astro';
import Vig from '../components/Vig.astro';
import WhereRegion from '../components/WhereRegion.astro';
import Foot from '../components/Foot.astro';
import { SITE, waLink, DIRECTIONS_URL } from '../lib/site';
import { RENT_PHONE } from '../lib/phones.mjs';
import { ICON_CALL, ICON_WA, ICON_ARROW, ICON_PIN } from '../lib/icons.mjs';
import { burst } from '../lib/burst.mjs';
import { splitMaster } from '../lib/mastermap.mjs';
import bands from '../assets/layout-bands.json';
import icoRoads from '../assets/icons/wide-roads.svg?raw';
import icoLight from '../assets/icons/street-light.svg?raw';
import icoGreen from '../assets/icons/planted-greenery.svg?raw';
import icoPower from '../assets/icons/power-supply.svg?raw';
import icoRain from '../assets/icons/sustainable.svg?raw';
const ico = (raw: string) => raw.replace(/^[\s\S]*?<g /, '<svg class="ico" viewBox="0 0 48 48" aria-hidden="true"><g ').replace(/<title>.*?<\/title>/g, '').replace(/<\/svg>\s*$/, '</svg>');
const masterSvg = splitMaster().shell;
const miniSvg = masterSvg.replace('id="mm-t"', 'id="ms-t"').replace('id="mm-d"', 'id="ms-d"').replace('aria-labelledby="mm-t mm-d"', 'aria-labelledby="ms-t ms-d"').replace('id="satellite-slot"', 'id="satellite-slot-s"');
const tel = SITE.phones[0];
const dir = DIRECTIONS_URL;
const heroWa = waLink('Hello, I want to see what is for sale at Isapur Industrial Park.');
const bandWa = (b: { id: string; label: string }) => waLink(b.id === 'shop' ? 'Hello, I am interested in a shop at Isapur Industrial Park. Please tell me what is available today.' : `Hello, I am looking for an industrial plot of ${b.label} at Isapur Industrial Park. Please tell me what is available today.`);
const chipHead = (b: { id: string; label: string }) => (b.id === 'shop' ? 'Shops' : b.label.replace(' sq yards', ''));
const scale: Record<string, number> = { b1: 0.62, b2: 0.8, b3: 1, shop: 0.38 };
const bp = burst();
const inside = [
  [icoRoads, '50 ft RCC roads', 'Wide concrete roads for loaded trucks.'],
  [icoLight, 'Street lighting', 'Installed along the roads.'],
  [icoGreen, 'Greenery', 'Planted inside the park.'],
  [icoPower, 'Power 24/7', 'Government supply on its own lines, coming in from both the Modinagar side and the Hapur side.'],
  [icoRain, 'Rain water harvesting', 'Part of every layout.'],
];
const rent = { // copy: 06_Content/voice/home-rent-lines.md
  eyebrow: 'For rent', h: 'Plots, sheds and factories on rent too',
  sub: 'Rent or lease a shed, start working in the park, buy a plot when you are ready.',
  items: ['A factory on a 100 sq yard plot is available now.'],
  call: 'Call', more: 'Sheds and factories for rent', wa: 'Ask about the factory for rent',
};
const rentWa = waLink('Hello, I saw the factory for rent on a 100 sq yard plot at Isapur Industrial Park. Please tell me more.');
const steps = [
  ['First meeting', 'We show you what is for sale today and walk you through the park and the papers.'],
  ['Approvals and answers', 'The park is approved by Zila Panchayat Ghaziabad. We show you the papers and give every question a straight answer.'],
  ['Payment plan', 'An industry standard plan, about three months on average. If you ever need to sell, we help you sell your land.'],
  ['Registry day', 'After about three months of payments we fix the registry day to suit both sides.'],
]; // DRAFT: owner-stated process, wording to be confirmed by the owner
const faq = [
  ['Is an industrial plot available today?', 'Call us and we show you what is available today, in all three phases, and help you find a plot that suits your needs.'],
  ['What plot sizes are there?', 'From 300 sq yards. The largest plots are 2000 to 2500 sq yards. Ask our sales team what is available in the size you need.'],
  ['How big is 300 sq yards?', 'About 2,700 sq ft, because one sq yard is nine sq ft. Think of a plot near 50 ft by 54 ft. The real shape is on the layout.'],
  ['Can trucks reach the plots?', 'The park has 50 ft RCC roads. On your visit, bring the vehicle you actually run and check the turn into your plot corner.'],
  ['Can I visit before I decide?', 'Yes, and you should. We are open 8 am to 8 pm every day except Tuesday. Call or message on WhatsApp and we fix a time.'],
];
const buildSteps = [
  ['Ground', 'Pegs and string mark your corners on the plot.', 'Pegs and string'],
  ['Footings', 'Concrete footings go in and the plinth ties them together.', 'RCC footings'],
  ['Frame', 'Steel columns and rafters go up, with girts and purlins between.', 'Steel frame'],
  ['Walls', 'Sheeting closes the walls, panel by panel.', 'Wall sheeting'],
  ['Roof', 'The green roof sheets go on from the eaves to the ridge.', 'Green roof'],
  ['Finish', 'The shutter goes up, lights and trees line the road, and you are open for business.', 'Roller shutter'],
];
---
<Home title="Industrial Plots for Sale | Isapur Industrial Park" description="Industrial plots for sale in Ghaziabad district on Hapur-Modinagar Road. 50 ft RCC roads, street lighting, planted greenery. See what is available today." path="/">
  <div class="wrap pair">
    <div class="pair__txt">
      <section class="hero" id="hero" aria-labelledby="hero-h">
        <p class="tag">The Groundwork for Growth.</p>
        <h1 id="hero-h">Industrial plots on Hapur-Modinagar Road, Ghaziabad</h1>
        <p class="lead">Looking for an industrial plot for sale in Ghaziabad? Plots in all three phases run from 300 sq yards to 2000 to 2500 sq yards, on 50 ft RCC roads. Tell us your size and your industry and we show you what is available today.</p>
        <div class="btns">
          <a class="b b--g" href={`tel:${tel.tel}`} data-cta-id="hero-call" data-section="hero"><Fragment set:html={ICON_CALL} />Call {tel.display}</a>
          <a class="b b--o" href={heroWa} rel="noopener" data-cta-id="hero-wa" data-section="hero"><Fragment set:html={ICON_WA} />See what is for sale</a>
        </div>
        <p class="fine">Open 8 am to 8 pm every day except Tuesday. For factories, warehouses, godowns and investors.</p>
        <div class="links">
        <a class="more" href="/plot-maps/" data-cta-id="hero-plotmaps" data-section="hero">See every plot on the plot maps<Fragment set:html={ICON_ARROW} /></a>
        <a class="more" href={dir} target="_blank" rel="noopener" data-cta-id="directions" data-section="hero">Get directions<Fragment set:html={ICON_PIN} /></a>
        </div>
      </section>
    </div>
    <div class="pair__vis">
      <div class="panel mm" data-mm>
        <svg class="burst" viewBox="0 0 800 800" aria-hidden="true"><polygon points={bp} fill="none" stroke="#E5E7EB" stroke-width="5"/></svg>
        <div class="mm__bar" role="group" aria-label="Choose a phase">
          <button type="button" class="mm__chip" data-ph="0" aria-pressed="true">All</button>
          <button type="button" class="mm__chip" data-ph="1" aria-pressed="false">Phase 1</button>
          <button type="button" class="mm__chip" data-ph="2" aria-pressed="false">Phase 2</button>
          <button type="button" class="mm__chip" data-ph="3" aria-pressed="false">Phase 3</button>
        </div>
        <div class="mm__vp" tabindex="0" aria-label="Master map of the park. Drag to move, use plus and minus to zoom, double tap to zoom in." data-src="/data/master-map.json">
          <div class="mm__drift"><Fragment set:html={masterSvg} /></div>
          <noscript><p class="mm__ns">The plot map needs JavaScript. Call us and we show you every plot.</p></noscript>
          <span class="mm__zoom"><button type="button" data-z="out" aria-label="Zoom out">&minus;</button><button type="button" data-z="in" aria-label="Zoom in">+</button><button type="button" data-z="reset" class="mm__rst" aria-label="Reset zoom">Reset</button></span>
          <p class="mm__tip" role="status" hidden></p>
        </div>
        <p class="cap">All three phases at one scale. Use plus and minus, pinch or double tap to zoom, touch a plot for its size.</p>
      </div>
    </div>
  </div>

  <div class="wrap rest">
    <div class="flow2">
      <section class="sec" id="where" aria-labelledby="where-h">
        <p class="eyebrow">Where it sits</p>
        <h2 id="where-h">4.2 km from the Delhi-Meerut Expressway</h2>
        <p class="sub">The park is on Hapur-Modinagar Road. One short drive puts you on the expressway, and from there Meerut, Ghaziabad and Delhi are one road away.</p>
        <WhereRegion />
        <a class="more" href="/location/">All distances and directions<Fragment set:html={ICON_ARROW} /></a>
      </section>

      <section class="sec" id="inside" aria-labelledby="inside-h">
        <p class="eyebrow">Inside the park</p>
        <h2 id="inside-h">Roads, lights and power inside the park</h2>
        <p class="sub">Units already running here make tile-bonding chemicals, comfort cushions, industrial water tanks and PVC pipes.</p>
        <ul class="feat">
          {inside.map(([svg, h, p]) => <li><Fragment set:html={ico(svg)} /><div><h3>{h}</h3><p>{p}</p></div></li>)}
        </ul>
      </section>

      <section class="sec" id="gate" aria-labelledby="gate-h">
        <p class="eyebrow">At the gate</p>
        <h2 id="gate-h">Fuel is at the gate</h2>
        <p class="sub">An IndianOil petrol pump stands right at the park's entry and exit. Your trucks fill up on the way in and the way out, and never run dry.</p>
        <Vig kind="gate" uid="vg" label="Architect style drawing of the park entry with two gate piers and an IndianOil petrol pump with a canopy beside it"/>
      </section>

      <section class="sec" id="shops" aria-labelledby="shops-h">
        <p class="eyebrow">Shops</p>
        <h2 id="shops-h">Shops for the people who serve the factories</h2>
        <p class="sub">Small commercial plots, right inside the park. A sweet shop, a quick-food counter, a tyre repair stall.</p>
        <Vig kind="shops" uid="vs" label="Architect style drawing of a row of small shop fronts with roller shutters, some up and some down"/>
        <a class="more" href={bandWa({ id: 'shop', label: 'shops' })} rel="noopener" data-cta-id="shops-wa" data-section="shops">Ask what shops are available<Fragment set:html={ICON_ARROW} /></a>
      </section>

      <section class="sec" id="sizes" aria-labelledby="sizes-h">
        <p class="eyebrow">Sizes in the park</p>
        <h2 id="sizes-h">An industrial plot for every size, 300 to 2500 sq yards</h2>
        <p class="sub">Plots run from 300 sq yards up to 2000 to 2500 sq yards. Tap a size and see those plots light up.</p>
        <ul class="chips" aria-label="Plot size">
          {bands.map((b) => <li><a class="chip" href={bandWa(b)} rel="noopener" data-band={b.id} data-n={b.n} data-wa={bandWa(b)} data-label={b.id === 'shop' ? 'shops' : b.label} data-sc={scale[b.id]} data-cta-id={`size-${b.id}`} data-section="sizes"><b>{chipHead(b)}</b><small>{b.n} plots</small></a></li>)}
        </ul>
        <div class="mm mm--s" data-mms>
          <div class="mm__vp" tabindex="0" aria-label="Map of all three phases with the plots of the chosen size lit up. Drag to move, use plus and minus to zoom." data-src="/data/master-map.json">
            <div class="mm__drift"><Fragment set:html={miniSvg} /></div>
            <span class="mm__zoom"><button type="button" data-z="out" aria-label="Zoom out">&minus;</button><button type="button" data-z="in" aria-label="Zoom in">+</button><button type="button" data-z="reset" class="mm__rst" aria-label="Reset zoom">Reset</button></span>
            <p class="mm__tip" role="status" hidden></p>
          </div>
        </div>
        <p class="out" id="find-out" aria-live="polite">Pick a size to see how many plots of it the layouts hold.</p>
        <a class="b b--y ask" id="find-ask" href={heroWa} rel="noopener" hidden data-cta-id="find-ask" data-section="sizes"><Fragment set:html={ICON_WA} />Ask what is available in this size</a>
      </section>

      <section class="sec" id="rent" aria-labelledby="rent-h">
        <p class="eyebrow">{rent.eyebrow}</p>
        <h2 id="rent-h">{rent.h}</h2>
        <p class="sub">{rent.sub}</p>
        <div class="rentcard">
          <Vig kind="rent" uid="vr" label="Architect style drawing of a small factory shed in elevation with a roller shutter, a side door and a green roof"/>
          <div class="rentcard__txt">
            <p class="pill">Available now</p>
            <ul class="rentlist">{rent.items.map((t) => <li>{t}</li>)}</ul>
            <div class="btns">
              <a class="b b--g" href={`tel:${RENT_PHONE.tel}`} data-cta-id="rent-call" data-section="rent"><Fragment set:html={ICON_CALL} />{rent.call} {RENT_PHONE.display}</a>
              <a class="b b--o" href={rentWa} rel="noopener" data-cta-id="rent-wa" data-section="rent"><Fragment set:html={ICON_WA} />{rent.wa}</a>
            </div>
            <a class="more" href="/industrial-shed-for-rent/" data-cta-id="rent-link" data-section="rent">{rent.more}<Fragment set:html={ICON_ARROW} /></a>
          </div>
        </div>
      </section>

      <section class="sec" id="papers" aria-labelledby="papers-h">
        <p class="eyebrow">The papers</p>
        <h2 id="papers-h">Start with the papers</h2>
        <p class="sub">Approved by Zila Panchayat Ghaziabad, the park and all three phases. Ask us to show you the papers.</p>
        <Vig kind="papers" uid="vp" label="Architect style drawing of a plan sheet with roads, plots, a north arrow and a green approval stamp"/>
        <a class="more" href="/approvals/" data-cta-id="papers-link" data-section="papers">See the approvals<Fragment set:html={ICON_ARROW} /></a>
      </section>

      <section class="sec" id="buying" aria-labelledby="buying-h">
        <p class="eyebrow">How buying works</p>
        <h2 id="buying-h">How buying a plot works</h2>
        <ol class="buy">
          {steps.map(([h, p], i) => <li><div class="num"><svg viewBox="0 0 800 800" aria-hidden="true"><polygon points={bp} fill={['#FFD600', '#0F4D3A', '#E53935', '#0F4D3A', '#FFD600'][i]}/></svg><b class={i === 1 || i === 2 || i === 3 ? 'lt' : ''}>{i + 1}</b></div><div><h3>{h}</h3><p>{p}</p></div></li>)}
        </ol>
      </section>

      <section class="sec" id="faq" aria-labelledby="faq-h">
        <p class="eyebrow">Questions</p>
        <h2 id="faq-h">Short answers</h2>
        <div class="faq">
          {faq.map(([q, a]) => <details><summary>{q}<span aria-hidden="true"></span></summary><p>{a}</p></details>)}
        </div>
        <p class="sub">Anything else, ask our sales team on <a href={`tel:${tel.tel}`} data-cta-id="faq-call" data-section="faq">{tel.display}</a>.</p>
      </section>
    </div>
  </div>

  <div class="wrap story" data-story>
    <aside class="stage" aria-label="A shed built on the plot, stage by stage">
      <div class="panel stagep">
        <Shed mode="stage" uid="st" />
        <p class="cap" id="stage-cap">One plot, built up stage by stage.</p>
        <ol class="steps">
          {buildSteps.map(([n], i) => <li><i><b class="k fill" style={`--i:${i};--s:0;--e:1`}></b></i><span>{n}</span></li>)}
        </ol>
      </div>
    </aside>
    <div class="flow">
      <section class="sec build" id="build" aria-labelledby="build-h">
        <p class="eyebrow">Build on it</p>
        <h2 id="build-h">From bare plot to working shed</h2>
        <p class="sub">Keep scrolling. The drawing builds as you read, one stage at a time.</p>
        <ol class="bsteps">
          {buildSteps.map(([, p, h], i) => <li class="bstep k" style={`--i:${i}`}><span class="bn">Stage {i + 1}</span><h3>{h}</h3><p>{p}</p></li>)}
        </ol>
      </section>
    </div>
  </div>

  <section class="fin" id="visit" aria-labelledby="visit-h">
    <div class="fin__run">
      <div class="wrap fin__stick">
        <p class="eyebrow">Visit the park</p>
        <h2 id="visit-h">Industrial plot available? Come and see it</h2>
        <div class="fin__art">
          <div class="fin__inside k kfade" style="--tl:--fin;--r0:95;--rw:100;--rh:0;--s:.3;--e:.55">
            <p class="status" data-open-now>Open 8 am to 8 pm, closed on Tuesday</p>
            <a class="b b--g" href={`tel:${tel.tel}`} data-cta-id="visit-call" data-section="visit"><Fragment set:html={ICON_CALL} />{tel.display}</a>
            <a class="b b--o fin__wa" href={heroWa} rel="noopener" data-cta-id="visit-wa-art" data-section="visit"><Fragment set:html={ICON_WA} />WhatsApp</a>
          </div>
          <Shed mode="finale" uid="fn" />
        </div>
      </div>
    </div>
    <div class="wrap">
      <div class="fin__info">
        <address>Hapur-Modinagar Road,<br>Yusufpur Isapur, Ghaziabad</address>
        <dl class="hours"><dt>Monday</dt><dd>8 am to 8 pm</dd><dt>Tuesday</dt><dd class="x">Closed</dd><dt>Wednesday to Sunday</dt><dd>8 am to 8 pm</dd></dl>
        <div class="btns">
          <a class="b b--g" href={dir} target="_blank" rel="noopener" data-cta-id="directions" data-section="visit">Get directions</a>
          <a class="b b--o" href={heroWa} rel="noopener" data-cta-id="visit-wa" data-section="visit"><Fragment set:html={ICON_WA} />WhatsApp {tel.display}</a>
        </div>
      </div>
    </div>
  </section>

  <div class="actionbar" role="region" aria-label="Call, WhatsApp or directions">
    <a class="b b--g b--call" href={`tel:${tel.tel}`} data-cta-id="sticky-call" data-section="sticky"><Fragment set:html={ICON_CALL} />Call</a>
    <a class="b b--o" href={waLink()} rel="noopener" aria-label="WhatsApp" data-cta-id="sticky-wa" data-section="sticky"><Fragment set:html={ICON_WA} /><span class="lbl">WhatsApp</span></a>
    <a class="b b--o b--dir" href={DIRECTIONS_URL} target="_blank" rel="noopener" aria-label="Get directions" data-cta-id="directions" data-section="sticky"><Fragment set:html={ICON_PIN} /><span class="lbl">Directions</span></a>
  </div>
  <Foot slot="footer" />
</Home>
