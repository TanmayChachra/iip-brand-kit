---
// v2 layout: taste-skill 2.5.1, kind = place. Markup follows assets/starter.html and sections.md (Place).
import placeCss from '../styles/place.css?raw';
import SEO from '../components/SEO.astro';
import Schema from '../components/Schema.astro';
import Gtm from '../components/Gtm.astro';
import { SITE, NAV, mapSearch } from '../lib/site';
import trackJs from '../scripts/track.js?raw';
interface Props {
  title: string; description: string; pageType: string; path: string; crumbs?: { name: string; href: string }[];
  faq?: { q: string; a: string }[]; article?: { date: Date }; place?: boolean; noindex?: boolean; home?: boolean; locationSlug?: string; hours?: boolean;
}
const { title, description, pageType, path, crumbs = [], faq, article, place, noindex, home = false, locationSlug = 'none' } = Astro.props;
const book = '/contact/#book';
const bookHref = home ? '#book' : book;
---
<!doctype html>
<html lang="en" data-type="place" data-radius="sharp" data-buttons="arrow" data-motion data-page-type={pageType} data-location-slug={locationSlug}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<SEO title={title} description={description} noindex={noindex} type={article ? 'article' : 'website'} />
<meta name="site-kind" content="other"><meta name="page-type" content="place"><meta name="page-kind" content="place">
<meta name="theme-color" content="#f3f5ef">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/fonts/Montserrat-VF-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/Inter-VF-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/system.css">
<link rel="stylesheet" href="/assets/ui/cards.css">
<link rel="stylesheet" href="/assets/motion/motion.css">
<link rel="stylesheet" href="/assets/backgrounds/backgrounds.css">
<link rel="stylesheet" href="/assets/layout/layout.css">
<link rel="stylesheet" href="/assets/moments/picture-develops/moment.css">
<style is:inline set:html={placeCss}></style>
<Schema path={path} title={title} description={description} crumbs={crumbs} faq={faq} article={article} place={place} />
<script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
<script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
<script is:inline src="/assets/backgrounds/backgrounds.js"></script>
<link rel="modulepreload" href="/assets/moments/moments.js"><link rel="modulepreload" href="/assets/moments/lib.js"><link rel="modulepreload" href="/assets/moments/picture-develops/moment.js">
<script is:inline set:html={trackJs}></script>
<Gtm />
</head>
<body>
<!-- plan: kind place. Deal: nav plain words (nav-cards dealt, no panel photographs), footer-columns, colour-band close,
     buttons arrow, offer composition strip, place composition wall, type moment address, moment picture-develops on the visit photograph -->
<header class="nav">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Skip to content</a>
    <a class="nav__logo" href="/" aria-label="Isapur Industrial Park, home"><img src="/brand/logo-horizontal.svg" width="93" height="40" alt="Isapur Industrial Park" translate="no"></a>
    <nav class="nav__links" aria-label="Main">
      {NAV.map((n) => <div class="nav__item"><a class="nav__link" href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></div>)}
    </nav>
    <div class="nav__actions"><a class="btn btn--primary" href={bookHref} data-cta-id="header-book" data-section="header">Book a site visit<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a></div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu"><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
  </div>
</header>

<main id="top">
  <slot />
</main>

<footer class="footer closing ground-brand" id="contact" aria-labelledby="close-h">
  <div class="wrap">
    <div class="closing__cta close--type">
      <div class="section-head">
        <h2 id="close-h">Book a site visit</h2>
        <p>{SITE.hours} Call and we fix a time.</p>
      </div>
      <a class="btn btn--primary close-btn" style="width:auto;justify-self:start;align-self:flex-start" href={bookHref} data-cta-id="close-book" data-section="close">Book a site visit<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
    </div>
    <div class="closing__links">
      <div class="grid">
        <div class="span-4 stack-4">
          <address class="footer__address-sm">Hapur-Modinagar Road,<br>Yusufpur Isapur, Ghaziabad</address>
          <p class="footer__phones"><a href={`tel:${SITE.phones[0].tel}`} data-cta-id="footer-call" data-section="footer">{SITE.phones[0].display}</a><br><a href={`tel:${SITE.phones[1].tel}`} data-cta-id="footer-call2" data-section="footer">{SITE.phones[1].display}</a></p>
        </div>
        <div class="span-2 footer__col"><h3>Visit</h3><ul><li><a href="/location/">Location</a></li><li><a href="/neighbours/">Around us</a></li><li><a href={mapSearch} rel="noopener">Directions</a></li></ul></div>
        <div class="span-2 footer__col"><h3>Plots</h3><ul><li><a href="/industrial-plots/">Plot sizes</a></li><li><a href="/amenities/">Roads and lighting</a></li><li><a href="/faq/">Questions</a></li></ul></div>
        <div class="span-4 footer__col"><h3>Industrial plots in</h3><ul class="two"><li><a href="/location/industrial-plots-in-modinagar/">Modinagar</a></li><li><a href="/location/industrial-plots-in-hapur/">Hapur</a></li><li><a href="/location/industrial-plots-in-ghaziabad/">Ghaziabad</a></li><li><a href="/location/industrial-plots-near-delhi-meerut-expressway/">Near the expressway</a></li><li><a href="/location/industrial-plots-in-bhojpur/">Bhojpur</a></li></ul></div>
      </div>
      <div class="footer__legal">
        <span>&copy; 2026 Isapur Industrial Park</span><a href="/privacy/">Privacy</a><a href="/blog/">Guides</a>
        <details class="credits"><summary>Photographs via Unsplash. Map data from OpenStreetMap contributors.</summary><p>Photographs from Unsplash under the Unsplash License, standing in until the park's own shoot. Map data © OpenStreetMap contributors (ODbL).</p></details>
      </div>
    </div>
  </div>
</footer>
<nav class="actionbar" aria-label="Quick actions">
  <a class="btn btn--secondary" href={`tel:${SITE.phones[0].tel}`} data-cta-id="bar-call" data-section="bar">Call now</a>
  <a class="btn btn--primary" href={bookHref} data-cta-id="bar-book" data-section="bar">Book a site visit</a>
</nav>
<script type="module" src="/assets/system.js"></script>
<script type="module" src="/assets/motion/motion.js"></script>
<script type="module" src="/assets/layout/layout.js"></script>
</body>
</html>
