---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const posts = (await getCollection('posts', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Industrial Plot Guides | Isapur Industrial Park" description="Practical guides for factory owners choosing an industrial plot in the Modinagar, Hapur and Ghaziabad belt." pageType="blog" path="/blog/" crumbs={[{ name: 'Home', href: '/' }, { name: 'Blog', href: '/blog/' }]}>
  <section class="pagehead"><div class="wrap"><p class="eyebrow">Guides</p><h1>Guides for factory owners</h1><p class="lead">Plain, practical notes on choosing and buying an industrial plot.</p></div></section>
  <div class="divider" aria-hidden="true"></div>
  <section class="sec"><div class="wrap grid g2 post-list">
    {posts.map((p) => <a class="card" href={`/blog/${p.id}/`}><time datetime={p.data.date.toISOString()}>{p.data.date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}</time><h3>{p.data.h1}</h3><p>{p.data.description}</p></a>)}
  </div></section>
</Base>
