---
import { fillDeep } from '../../lib/phones.mjs';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
export async function getStaticPaths() {
  return (await getCollection('posts', (p) => !p.data.draft)).map((p) => ({ params: { slug: p.id }, props: { entry: p } }));
}
const { entry } = Astro.props; const d = fillDeep(entry.data); const { Content } = await render(entry); const path = `/blog/${entry.id}/`;
const when = d.date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={d.title} description={d.description} pageType="blog" path={path} article={{ date: d.date }} faq={d.faq} crumbs={[{ name: 'Home', href: '/' }, { name: 'Blog', href: '/blog/' }, { name: d.h1, href: path }]}>
  <section class="pagehead"><div class="wrap"><p class="eyebrow">Guide</p><h1>{d.h1}</h1><p class="lead"><time datetime={d.date.toISOString()}>{when}</time></p></div></section>
  <div class="divider" aria-hidden="true"></div>
  <section class="sec"><div class="wrap"><div class="prose"><Content /></div><CTA section="blog" id="blog" directions /></div></section>
</Base>
